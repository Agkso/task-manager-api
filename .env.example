# Copie para .env (ou exporte no ambiente/orquestrador) e preencha com valores reais.
# Nenhum destes deve ir para o repositorio com valor real - os defaults em
# application.yml servem so para rodar local/teste tecnico.

DB_URL=jdbc:postgresql://localhost:5433/taskmanager
DB_USERNAME=taskmanager
DB_PASSWORD=taskmanager

# Gere o seu com: openssl rand -base64 64 (nunca reaproveite o de outro ambiente)
JWT_SECRET=troque-por-um-valor-gerado-com-openssl-rand--base64-64
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_REFRESH_CLEANUP_RETENTION_DAYS=30

RATE_LIMIT_CAPACIDADE=5
RATE_LIMIT_JANELA_MINUTOS=1

# Origens do frontend autorizadas a chamar a API (separadas por virgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
